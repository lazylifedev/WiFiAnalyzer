    <string name="wifi_scan">Wi-Fi scan</string><string name="wifi_permission_explanation">Used only to scan nearby Wi-Fi and display SSIDs, BSSIDs, and signal strength. Location itself is not saved.</string><string name="camera">Camera</string><string name="camera_permission_explanation">Used for OCR capture. Permission is requested immediately before capture.</string><string name="photo_picker">Photo picker</string><string name="photo_picker_explanation">Uses the Android photo picker, so access to the entire photo library is not requested.</string><string name="open_android_settings">Open Android Settings</string><string name="allow_wifi_permission">Allow Wi-Fi Permission</string>
    <string name="help_scan_title">Analyze Wi-Fi</string><string name="help_scan_body">The screen continuously reflects the latest OS data. Refresh on Home requests a new Wi-Fi scan.</string><string name="help_add_device_title">Add a device</string><string name="help_add_device_body">Use Save as Device in scan results or the add action on Saved Devices.</string><string name="help_ocr_title">Add with OCR</string><string name="help_ocr_body">Capture or select a label, review the scan results, and then add the device.</string><string name="help_photos_title">Manage photos</string><string name="help_photos_body">Add and review photos from device details. Photos may contain sensitive information.</string><string name="help_workspace_groups_title">Workspaces and groups</string><string name="help_workspace_groups_body">Workspaces separate stored data, while groups organize devices.</string><string name="help_backup_body">Create or restore a ZIP file from the Data section in Settings.</string><string name="help_csv_title">CSV import and export</string><string name="help_csv_body">Export saved data to CSV or review and import a CSV file.</string><string name="faq">Frequently asked questions</string><string name="help_faq_body">If scanning does not work, check permissions, Location Services, and Wi-Fi settings.</string><string name="about_permissions">About permissions</string><string name="privacy_summary">Wi-Fi information and saved data are processed and stored on this device. The app does not send data automatically. Data is shared only when you choose a backup destination or sharing app. Photos may contain sensitive information. Location permission is used only for Wi-Fi scanning; location itself is not saved.</string>
